# Copy to .env for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# GMAIL_APP_PASSWORD is a 16-character Google App Password (needs 2-Step Verification),
# not your normal Gmail password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where leads are delivered (defaults to GMAIL_USER)
LEAD_TO=
